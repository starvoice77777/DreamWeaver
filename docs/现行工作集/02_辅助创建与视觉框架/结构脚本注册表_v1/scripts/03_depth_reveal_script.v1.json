{
  "contract_version": "dreamweaver-structure-script-v1",
  "script_id": "depth_reveal_script",
  "script_version": "1.0.0",
  "framework_id": "depth_reveal",
  "product_name": "远近分层",
  "description": "以远景持续层、中景主体层和近景低密度层组织场景；三档状态只切换已审核的相对混音和距离配置。",
  "execution_status": "implementation_ready",
  "review_status": "pending_listening_review",
  "controller": {
    "parameter": "depth_reveal",
    "value_type": "enum",
    "allowed_values": ["near", "balanced", "far"],
    "default_value": "balanced",
    "apply_timing": "on_selection_with_short_ramp",
    "feedback": "已突出当前远近层"
  },
  "sound_budget": {
    "request": {"min_objects": 1, "max_objects": 4},
    "compiled_scene": {
      "min_objects": 2,
      "max_objects": 4,
      "bed": {"min": 1, "max": 1},
      "ambience": {"min": 0, "max": 1},
      "foreground": {"min": 0, "max": 3},
      "ambience_plus_foreground": {"min": 1, "max": 3},
      "voice_max": 1
    }
  },
  "structural_slots": [
    {
      "slot_id": "far_sustained",
      "visual_zone": "far",
      "required_for_playable": true,
      "min_objects": 1,
      "max_objects": 1,
      "allowed_roles": ["bed", "ambience"],
      "playback_classes": ["continuous", "bounded_loop"],
      "supplement_allowed": true,
      "assignment_priority": 1
    },
    {
      "slot_id": "mid_subject",
      "visual_zone": "mid",
      "required_for_playable": true,
      "min_objects": 1,
      "max_objects": 1,
      "allowed_roles": ["bed", "ambience", "action", "voice"],
      "playback_classes": ["continuous", "bounded_loop", "phrase_sequence"],
      "supplement_allowed": true,
      "assignment_priority": 2
    },
    {
      "slot_id": "near_detail",
      "visual_zone": "near",
      "required_for_playable": false,
      "min_objects": 0,
      "max_objects": 2,
      "allowed_roles": ["action", "trigger", "voice"],
      "playback_classes": ["episodic", "oneshot", "phrase_sequence"],
      "supplement_allowed": false,
      "assignment_priority": 3
    }
  ],
  "state_resolution": {
    "mode": "discrete_profile_lookup",
    "profile_source": "approved_content_preset",
    "rules": [
      "Map near, balanced or far to one reviewed distance profile.",
      "Resolve relative mix and position presets without emitting raw coordinates.",
      "Keep every assigned scene role and event schedule unchanged.",
      "Reject a profile whose full motion path fails the spatial safety gate."
    ],
    "profile_keys": {
      "near": "depth_near_profile_id",
      "balanced": "depth_balanced_profile_id",
      "far": "depth_far_profile_id"
    },
    "mutable_dimensions": ["relative_mix", "approved_distance_profile"],
    "immutable_dimensions": ["resource_binding", "scene_role", "event_frequency", "event_schedule"]
  },
  "compile_pipeline": [
    {"step_id": "validate_input", "processor": "generation_request_gate", "on_failure": "fail"},
    {"step_id": "resolve_approved_bindings", "processor": "frame_binding_gate", "on_failure": "needs_clarification"},
    {"step_id": "assign_structural_slots", "processor": "depth_zone_slot_assigner", "on_failure": "needs_clarification"},
    {"step_id": "apply_framework_state", "processor": "approved_depth_profile_resolver", "on_failure": "preserve_and_report"},
    {"step_id": "preserve_manual_overrides", "processor": "manual_track_protection_gate", "on_failure": "needs_clarification"},
    {"step_id": "emit_scene_draft", "processor": "deterministic_timeline_compiler", "on_failure": "fail"}
  ],
  "safety_rules": [
    "do_not_change_asset_kind",
    "do_not_delete_non_target_objects",
    "do_not_modify_user_locked_objects",
    "do_not_overwrite_manual_tracks_without_confirmation",
    "do_not_emit_arbitrary_cues",
    "do_not_emit_arbitrary_coordinates",
    "do_not_bypass_approved_bindings",
    "preserve_scene_roles",
    "preserve_event_frequency",
    "approved_distance_profiles_only",
    "validate_full_motion_path"
  ],
  "manual_override_policy": {
    "mode": "preserve_by_default",
    "protected_track_selector": "source_scene.manual_override_track_ids",
    "on_conflict": "require_explicit_confirmation",
    "conflict_output": "impact_list",
    "no_implicit_override": true
  },
  "supplement_policy": {
    "allowed": true,
    "origin": "system_supplement",
    "binding_status": "approved",
    "requires_reason": true,
    "max_result_objects": 4,
    "readd_user_deleted": false,
    "on_missing_required_slot": "needs_clarification_or_explicit_supplement"
  },
  "output_contract": {
    "scene_draft_contract": "ai-scene-generation-v1",
    "timeline_contract": "timeline-contract-v1",
    "cue_authority": "deterministic_timeline_compiler",
    "required_dependency_versions": ["catalog", "binding_index", "content_preset", "script", "motion_registry"]
  },
  "acceptance": {
    "automated": ["controller_enum_valid", "required_depth_slots_resolved", "roles_and_event_schedule_unchanged"],
    "listening": ["three_depth_states_are_distinguishable", "no_nearfield_startle", "all_motion_paths_are_safe"]
  }
}
