{
  "contract_version": "dreamweaver-structure-script-v1",
  "script_id": "focus_selector_script",
  "script_version": "1.0.0",
  "framework_id": "focus_selector",
  "product_name": "主声突出",
  "description": "在稳定底层上组织最多三个可选声音目标；焦点只改变持续声音主次和未来事件偏向，不删除对象或即时触发一次性事件。",
  "execution_status": "implementation_ready",
  "review_status": "pending_listening_review",
  "controller": {
    "parameter": "focus_target",
    "value_type": "sound_object_id",
    "default_value": null,
    "max_targets": 3,
    "target_scope": "assigned_focus_targets",
    "apply_timing": "sustained_now_future_events_later",
    "feedback": "显示当前主声名称"
  },
  "sound_budget": {
    "request": {"min_objects": 1, "max_objects": 4},
    "compiled_scene": {
      "min_objects": 2,
      "max_objects": 4,
      "bed": {"min": 1, "max": 1},
      "ambience": {"min": 0, "max": 1},
      "foreground": {"min": 0, "max": 3},
      "ambience_plus_foreground": {"min": 1, "max": 3},
      "voice_max": 1
    }
  },
  "structural_slots": [
    {
      "slot_id": "stable_room_bed",
      "visual_zone": "background",
      "required_for_playable": true,
      "min_objects": 1,
      "max_objects": 1,
      "allowed_roles": ["bed"],
      "playback_classes": ["continuous", "bounded_loop"],
      "supplement_allowed": true,
      "assignment_priority": 1
    },
    {
      "slot_id": "focus_targets",
      "visual_zone": "focus_field",
      "required_for_playable": true,
      "min_objects": 1,
      "max_objects": 3,
      "allowed_roles": ["ambience", "action", "trigger", "voice"],
      "playback_classes": ["continuous", "bounded_loop", "episodic", "oneshot", "phrase_sequence"],
      "supplement_allowed": false,
      "assignment_priority": 2
    }
  ],
  "state_resolution": {
    "mode": "validated_target_lookup",
    "profile_source": "approved_content_preset",
    "rules": [
      "Require focus_target to match one assigned focus target sound_object_id.",
      "For active sustained audio, apply the preset's reviewed focus mix profile through a ramp.",
      "For episodic audio, change only future eligible event preference.",
      "Keep every non-focused object present and within its reviewed floor."
    ],
    "required_profile_keys": ["focus_mix_profile_id", "future_event_bias_profile_id"],
    "mutable_dimensions": ["relative_mix", "future_event_candidate_priority"],
    "immutable_dimensions": ["resource_binding", "object_membership", "current_oneshot", "event_frequency"]
  },
  "compile_pipeline": [
    {"step_id": "validate_input", "processor": "generation_request_gate", "on_failure": "fail"},
    {"step_id": "resolve_approved_bindings", "processor": "frame_binding_gate", "on_failure": "needs_clarification"},
    {"step_id": "assign_structural_slots", "processor": "focus_target_slot_assigner", "on_failure": "needs_clarification"},
    {"step_id": "apply_framework_state", "processor": "approved_focus_profile_resolver", "on_failure": "preserve_and_report"},
    {"step_id": "preserve_manual_overrides", "processor": "manual_track_protection_gate", "on_failure": "needs_clarification"},
    {"step_id": "emit_scene_draft", "processor": "deterministic_timeline_compiler", "on_failure": "fail"}
  ],
  "safety_rules": [
    "do_not_change_asset_kind",
    "do_not_delete_non_target_objects",
    "do_not_modify_user_locked_objects",
    "do_not_overwrite_manual_tracks_without_confirmation",
    "do_not_emit_arbitrary_cues",
    "do_not_emit_arbitrary_coordinates",
    "do_not_bypass_approved_bindings",
    "retain_non_focused_objects",
    "do_not_trigger_oneshot_on_focus_change",
    "future_events_only_for_trigger_bias",
    "focus_target_must_reference_existing_object"
  ],
  "manual_override_policy": {
    "mode": "preserve_by_default",
    "protected_track_selector": "source_scene.manual_override_track_ids",
    "on_conflict": "require_explicit_confirmation",
    "conflict_output": "impact_list",
    "no_implicit_override": true
  },
  "supplement_policy": {
    "allowed": true,
    "origin": "system_supplement",
    "binding_status": "approved",
    "requires_reason": true,
    "max_result_objects": 4,
    "readd_user_deleted": false,
    "on_missing_required_slot": "needs_clarification_or_explicit_supplement"
  },
  "output_contract": {
    "scene_draft_contract": "ai-scene-generation-v1",
    "timeline_contract": "timeline-contract-v1",
    "cue_authority": "deterministic_timeline_compiler",
    "required_dependency_versions": ["catalog", "binding_index", "content_preset", "script", "motion_registry"]
  },
  "acceptance": {
    "automated": ["focus_target_exists", "focus_target_count_at_most_three", "non_focused_objects_retained"],
    "listening": ["focus_change_is_smooth", "non_targets_remain_audible", "focus_change_does_not_fire_oneshot"]
  }
}
