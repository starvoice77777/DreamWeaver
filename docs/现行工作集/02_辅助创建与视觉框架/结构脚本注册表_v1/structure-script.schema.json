{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamweaver.local/schemas/structure-script-v1.schema.json",
  "title": "DreamWeaver Structure Script v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "script_id",
    "script_version",
    "framework_id",
    "product_name",
    "description",
    "execution_status",
    "review_status",
    "controller",
    "sound_budget",
    "structural_slots",
    "state_resolution",
    "compile_pipeline",
    "safety_rules",
    "manual_override_policy",
    "supplement_policy",
    "output_contract",
    "acceptance"
  ],
  "properties": {
    "contract_version": {"const": "dreamweaver-structure-script-v1"},
    "script_id": {"type": "string", "pattern": "^[a-z0-9_]+_script$"},
    "script_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "framework_id": {
      "enum": ["boundary_gate", "enclosure_control", "depth_reveal", "focus_selector", "nearfield_width"]
    },
    "product_name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "execution_status": {"const": "implementation_ready"},
    "review_status": {"enum": ["pending_listening_review", "approved", "rejected"]},
    "controller": {
      "type": "object",
      "additionalProperties": true,
      "required": ["parameter", "value_type", "default_value", "apply_timing", "feedback"]
    },
    "sound_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "compiled_scene"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_objects", "max_objects"],
          "properties": {
            "min_objects": {"const": 1},
            "max_objects": {"const": 4}
          }
        },
        "compiled_scene": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_objects", "max_objects", "bed", "ambience", "foreground", "ambience_plus_foreground", "voice_max"],
          "properties": {
            "min_objects": {"const": 2},
            "max_objects": {"const": 4},
            "bed": {"$ref": "#/$defs/minMax"},
            "ambience": {"$ref": "#/$defs/minMax"},
            "foreground": {"$ref": "#/$defs/minMax"},
            "ambience_plus_foreground": {"$ref": "#/$defs/minMax"},
            "voice_max": {"const": 1}
          }
        }
      }
    },
    "structural_slots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/slot"}
    },
    "state_resolution": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "profile_source", "rules"]
    },
    "compile_pipeline": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/compileStep"}
    },
    "safety_rules": {
      "type": "array",
      "minItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "manual_override_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "protected_track_selector", "on_conflict", "conflict_output", "no_implicit_override"],
      "properties": {
        "mode": {"const": "preserve_by_default"},
        "protected_track_selector": {"const": "source_scene.manual_override_track_ids"},
        "on_conflict": {"const": "require_explicit_confirmation"},
        "conflict_output": {"const": "impact_list"},
        "no_implicit_override": {"const": true}
      }
    },
    "supplement_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "origin", "binding_status", "requires_reason", "max_result_objects", "readd_user_deleted", "on_missing_required_slot"],
      "properties": {
        "allowed": {"const": true},
        "origin": {"const": "system_supplement"},
        "binding_status": {"const": "approved"},
        "requires_reason": {"const": true},
        "max_result_objects": {"const": 4},
        "readd_user_deleted": {"const": false},
        "on_missing_required_slot": {"const": "needs_clarification_or_explicit_supplement"}
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_draft_contract", "timeline_contract", "cue_authority", "required_dependency_versions"],
      "properties": {
        "scene_draft_contract": {"const": "ai-scene-generation-v1"},
        "timeline_contract": {"const": "timeline-contract-v1"},
        "cue_authority": {"const": "deterministic_timeline_compiler"},
        "required_dependency_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automated", "listening"],
      "properties": {
        "automated": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "listening": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "minMax": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": {"type": "integer", "minimum": 0, "maximum": 4},
        "max": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "visual_zone", "required_for_playable", "min_objects", "max_objects", "allowed_roles", "playback_classes", "supplement_allowed", "assignment_priority"],
      "properties": {
        "slot_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "visual_zone": {"type": "string", "minLength": 1},
        "required_for_playable": {"type": "boolean"},
        "min_objects": {"type": "integer", "minimum": 0, "maximum": 3},
        "max_objects": {"type": "integer", "minimum": 1, "maximum": 3},
        "allowed_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["bed", "ambience", "action", "trigger", "voice", "transition"]}
        },
        "playback_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["continuous", "bounded_loop", "episodic", "oneshot", "phrase_sequence"]}
        },
        "supplement_allowed": {"type": "boolean"},
        "assignment_priority": {"type": "integer", "minimum": 1}
      }
    },
    "compileStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "processor", "on_failure"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1},
        "processor": {"type": "string", "minLength": 1},
        "on_failure": {"enum": ["fail", "needs_clarification", "preserve_and_report"]}
      }
    }
  }
}
