{
  "scene_id": "a1111111-1111-4111-8111-111111111101",
  "version": 5,
  "automation_mode": "official_auto",
  "duration_hint_seconds": 620,
  "override_policy": "per_source_manual_exit",
  "manual_override_track_ids": [],
  "phrases": [
    {"id": "f6666666-6666-4666-8666-666666666701", "text": "先靠好，什么都不用做。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-666666666702", "text": "今天就慢一点。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-666666666703", "text": "水温已经调好了。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-666666666704", "text": "如果愿意，就慢慢靠近一点。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-666666666705", "text": "温水从发顶慢慢落下来。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-666666666706", "text": "头发慢慢变重，也慢慢放松。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-666666666707", "text": "取一点点，轻轻揉开。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-666666666708", "text": "先不用用力，让泡沫自己铺开。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-666666666709", "text": "这里慢一点，放松就好。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-66666666670a", "text": "从发顶开始，轻轻按一按。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-66666666670b", "text": "耳边这里，也慢慢放松下来。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-66666666670c", "text": "泡沫会被温水慢慢带走。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-66666666670d", "text": "剩下的泡沫，也一起带走。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-66666666670e", "text": "已经很干净了，慢慢就好。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-66666666670f", "text": "用柔软的毛巾，轻轻按一按。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-666666666710", "text": "不是擦，只是轻轻按住。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-666666666711", "text": "现在只剩下很轻的按压。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-666666666712", "text": "你不用再做什么了。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-666666666713", "text": "就这样安静躺一会儿。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}},
    {"id": "f6666666-6666-4666-8666-666666666714", "text": "剩下的时间，安心休息。", "review_status": "approved", "voice_binding": {"kind": "official_resource", "resource_key": "voice_phrase_mom", "track_id": "e5555555-5555-4555-8555-555555555503", "track_layer": "voice"}}
  ],
