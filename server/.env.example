DW_ENVIRONMENT=development
DW_DEBUG=false
DW_DATABASE_URL=postgresql+asyncpg://dreamweaver:dreamweaver@localhost:5432/dreamweaver
DW_REDIS_URL=redis://localhost:6379/0
DW_OBJECT_STORAGE_ENDPOINT=localhost:9000
DW_OBJECT_STORAGE_ACCESS_KEY=dreamweaver
DW_OBJECT_STORAGE_SECRET_KEY=dreamweaver-local-only
DW_OBJECT_STORAGE_BUCKET=dreamweaver-private
DW_OBJECT_STORAGE_SECURE=false
# Optional: host clients use for PUT/GET (defaults to endpoint). e.g. localhost:9000
# DW_OBJECT_STORAGE_PUBLIC_ENDPOINT=localhost:9000
DW_UPLOAD_MAX_BYTES=26214400
DW_UPLOAD_URL_EXPIRES_SECONDS=3600
DW_PLAYBACK_URL_EXPIRES_SECONDS=900
DW_VOICE_PROVIDER=stub
# Must match iOS PRODUCT_BUNDLE_IDENTIFIER (aud claim). Official: zhimeng.DreamWeaver
# Device联调 on Team DF548S4JJY: zhimeng.DreamWeaver.df
DW_APPLE_CLIENT_ID=zhimeng.DreamWeaver.df
DW_APPLE_ISSUER=https://appleid.apple.com
DW_APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
DW_APPLE_JWKS_CACHE_SECONDS=3600
# Omit to auto-enable in development/test; set false in production.
# DW_ALLOW_DEV_APPLE_AUTH=false
# Upsert official catalog at API startup (ignored in production).
# Omit to auto-enable in development/local; set false to skip, true to force.
# DW_FORCE_RESEED_CATALOG=true
# Set false in unit tests without Redis; leave true for local docker compose.
# DW_READY_PROBE_REDIS=true
